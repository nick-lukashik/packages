{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": ["**", "!**/dist", "!**/coverage", "!**/*.md", "!ui/demo/dist"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120,
        "lineEnding": "lf"
    },
    "javascript": {
        "parser": {
            "unsafeParameterDecoratorsEnabled": true
        },
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "double",
            "semicolons": "asNeeded",
            "trailingCommas": "all",
            "arrowParentheses": "asNeeded",
            "bracketSpacing": true,
            "bracketSameLine": false,
            "quoteProperties": "asNeeded",
            "attributePosition": "multiline",
            "expand": "always",
            "operatorLinebreak": "before"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "linter": {
        "enabled": true,
        "domains": {
            "drizzle": "recommended",
            "test": "recommended"
        },
        "rules": {
            "preset": "recommended",
            "style": {
                "useImportType": "off",
                "useConsistentArrayType": {
                    "level": "error",
                    "options": {
                        "syntax": "shorthand"
                    }
                },
                "useConsistentTypeDefinitions": {
                    "level": "error",
                    "options": {
                        "style": "type"
                    }
                },
                "useFilenamingConvention": {
                    "level": "error",
                    "options": {
                        "filenameCases": ["kebab-case"]
                    }
                }
            },
            "complexity": {
                "noStaticOnlyClass": "off"
            },
            "suspicious": {
                "noDrizzleUpdateWithoutWhere": {
                    "level": "error",
                    "options": {
                        "drizzleObjectName": ["db", "tx"]
                    }
                },
                "noDrizzleDeleteWithoutWhere": {
                    "level": "error",
                    "options": {
                        "drizzleObjectName": ["db", "tx"]
                    }
                }
            }
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["ui/src/components/**", "ui/src/hooks/**", "ui/src/lib/highlighter.tsx"],
            "linter": {
                "rules": {
                    "a11y": {
                        "noNoninteractiveTabindex": "off",
                        "noRedundantRoles": "off",
                        "useFocusableInteractive": "off",
                        "useKeyWithClickEvents": "off",
                        "useSemanticElements": "off"
                    },
                    "correctness": {
                        "noComponentHookFactories": "off",
                        "useExhaustiveDependencies": "off"
                    },
                    "security": {
                        "noDangerouslySetInnerHtml": "off"
                    },
                    "suspicious": {
                        "noArrayIndexKey": "off",
                        "noDocumentCookie": "off",
                        "noDoubleEquals": "off"
                    }
                }
            }
        }
    ]
}
