{
    "name": "@nick-lukashik/auth",
    "version": "0.2.0",
    "description": "Access tokens of id-api: verification through JWKS, permissions, Nest guards",
    "type": "module",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "https://github.com/nick-lukashik/packages.git",
        "directory": "auth"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./nest": {
            "types": "./dist/nest/index.d.ts",
            "default": "./dist/nest/index.js"
        }
    },
    "scripts": {
        "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "jose": "6.2.14"
    },
    "peerDependencies": {
        "@nestjs/common": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.0"
    },
    "peerDependenciesMeta": {
        "@nestjs/common": {
            "optional": true
        },
        "@nestjs/core": {
            "optional": true
        },
        "reflect-metadata": {
            "optional": true
        },
        "rxjs": {
            "optional": true
        }
    }
}
