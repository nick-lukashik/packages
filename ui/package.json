{
    "name": "@nick-lukashik/ui",
    "version": "0.3.0",
    "description": "Mono Brutal UI kit of nick-lukashik.com: tokens and Tailwind theme, shadcn/ui components restyled, brand marks, section blocks, the page roulette",
    "type": "module",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "https://github.com/nick-lukashik/packages.git",
        "directory": "ui"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "sideEffects": [
        "*.css"
    ],
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./next": {
            "types": "./dist/next/index.d.ts",
            "default": "./dist/next/index.js"
        },
        "./styles.css": "./dist/styles/index.css",
        "./fonts.css": "./dist/styles/fonts.css"
    },
    "scripts": {
        "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"fs.cpSync('src/styles','dist/styles',{recursive:true,filter:f=>!f.endsWith('.test.ts')})\"",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "demo": "node scripts/demo.ts"
    },
    "dependencies": {
        "@base-ui/react": "1.9.0",
        "@fontsource/martian-mono": "5.3.0",
        "@fontsource/sofia-sans-extra-condensed": "5.3.0",
        "@shadcn/react": "0.3.1",
        "class-variance-authority": "0.7.1",
        "cmdk": "1.1.1",
        "cn": "0.5.1",
        "embla-carousel-react": "8.6.0",
        "input-otp": "1.5.0",
        "lucide-react": "1.65.0",
        "radix-ui": "1.8.1",
        "react-day-picker": "10.0.2",
        "react-resizable-panels": "4.19.1",
        "recharts": "3.8.0",
        "shiki": "4.6.0",
        "sonner": "2.0.8",
        "vaul": "1.1.2"
    },
    "peerDependencies": {
        "next": ">=16.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "peerDependenciesMeta": {
        "next": {
            "optional": true
        }
    },
    "devDependencies": {
        "@tailwindcss/cli": "4.3.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "esbuild": "0.28.2",
        "next": "16.4.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "shadcn": "4.23.0"
    }
}
