{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "experimentalDecorators": false,
        "emitDecoratorMetadata": false,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "types": ["node"]
    },
    "include": ["src"],
    "exclude": ["src/**/*.test.ts"]
}
